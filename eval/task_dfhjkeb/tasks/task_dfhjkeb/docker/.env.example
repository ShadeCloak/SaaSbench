# Container application port (host -> container mapping)
APP_PORT=8003

# PostgreSQL settings
DB_PORT=5432
DB_NAME=app_db
DB_USER=app
DB_PASSWORD=please_replace_via_openssl_rand_base64_24

# Redis settings (host port mapped to container's 6379)
REDIS_PORT=6389

# Application secrets — MUST be replaced before running
JWT_SECRET=please_replace_via_openssl_rand_base64_64
COOKIE_SECRET=please_replace_via_openssl_rand_base64_64

# Toggle role-based access control checks
ENABLE_RBAC=false

# Image variant:
#   - baseline: reference image bundling the upstream framework runtime; used by check/task_dfhjkeb/test_source_code.sh
#   - model:    clean development environment derived from the saasbench-dev base; used by check/task_dfhjkeb/prepare_workspace.sh and test_model_output.sh
IMAGE_TAG=model

# (Optional) LLM-judge evaluator credentials — required to score LLM_* DAG nodes.
# Leave unset to skip LLM-judge nodes (they will be marked SKIPPED_LLM).
# LLM_API_KEY=
# LLM_API_BASE=https://api.openai.com/v1
# LLM_MODEL=gpt-4o
