# =============================================================================
# Dockerfile.model template — generic Node + Python task variant
# =============================================================================
# The base image already provides: Ubuntu, Go, Node 20 (yarn4/pnpm), Python 3.10,
# and a shared cache of common JS/TS toolchains (React/Vue/Vite/Webpack/NX/
# Express/NestJS/Prisma/...). This template is suitable for tasks that do not
# need any additional language runtime; it only enforces idle PID 1 and the
# /app workspace mount so the model can build the project from scratch.
# =============================================================================

FROM shadetocloak/saasbench-dev:base

WORKDIR /app
ENTRYPOINT []
CMD ["sleep", "infinity"]
