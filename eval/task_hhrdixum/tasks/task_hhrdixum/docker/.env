# task_hhrdixum environment overrides
#
# The values below mirror the defaults baked into docker-compose.yml; they exist
# here so an operator can edit a single file to retune the stack without
# touching the compose file. All variables follow the APP_* naming convention
# adopted in task.md § 8.

# ----- Database (PostgreSQL) -------------------------------------------------
# These are the values consumed by the app *inside* the docker network.
APP_DB_ENGINE=postgresql
APP_DB_NAME=app_hhrdixum
APP_DB_USER=apphhrdixum
APP_DB_PASSWORD=app123hhrdixum
APP_DB_HOST=db
APP_DB_PORT=5432

# Host-side connection (for evaluation scripts running OUTSIDE the docker
# network — e.g. the evaluation harness running on the host or a CI runner).
# host:port mapping comes from docker-compose.yml § services.db.ports.
APP_DB_HOST_EXTERNAL=localhost
APP_DB_PORT_EXTERNAL=5439

# ----- Cache & background broker (Redis) -------------------------------------
APP_CACHE_ENABLED=True
APP_CACHE_HOST=cache
APP_CACHE_PORT=6379
APP_BACKGROUND_WORKERS=4

# Host-side Redis (same rationale as APP_DB_HOST_EXTERNAL).
APP_CACHE_HOST_EXTERNAL=localhost
APP_CACHE_PORT_EXTERNAL=6380

# ----- App secrets & host config --------------------------------------------
# IMPORTANT: replace APP_SECRET_KEY with a random ≥50-char string in production.
APP_SECRET_KEY=dev-only-secret-change-me-to-a-random-50char-string-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
APP_DEBUG=True
APP_ALLOWED_HOSTS=*
APP_CORS_ALLOW_ALL=True
APP_CORS_ORIGIN_WHITELIST=http://localhost:8014,http://127.0.0.1:8014
APP_BASE_URL=http://localhost:8014
APP_TIMEZONE=UTC
APP_LANGUAGE=en

# ----- Mail (default: console backend, no real SMTP) -------------------------
APP_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# ----- Pricing / Currency ---------------------------------------------------
APP_DEFAULT_CURRENCY=USD

# ----- Plugins --------------------------------------------------------------
APP_PLUGINS_ENABLED=True

# ----- Django settings module (agent-implementable) -------------------------
DJANGO_SETTINGS_MODULE=app.settings

# ----- Entrypoint script (used by app service `command:`) -------------------
# task.md § 8.8 recommends but does not mandate a fixed path; the compose
# command falls back to /app/bin/start.sh when this is unset.
# APP_START_SCRIPT=/app/bin/start.sh
APP_START_SCRIPT=/app/bin/start.sh

# IMAGE_TAG selects which app image variant to use:
#   - baseline: full runtime image
#   - model:    clean development base image (no app preinstalled)
IMAGE_TAG=baseline
