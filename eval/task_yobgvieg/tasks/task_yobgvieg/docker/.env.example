# =============================================================================
# task_yobgvieg .env.example
# Copy this file to .env and replace all `please_replace_*` placeholders with
# real secrets before running `docker compose up -d`.
#
# Generate strong secrets with:
#   - openssl rand -base64 24      # passwords
#   - python -c "import secrets; print(secrets.token_hex(32))"   # SECRET_KEY
# =============================================================================

# ---- Database (PostgreSQL) ----
# The username, db name and host are stable interface contracts referenced by
# both docker-compose.yml and the evaluator (config.py). Only the password is
# a true secret.
DATABASE_URL=postgresql://appyobgvieg:please_replace_via_openssl_rand_base64_24@db:5432/app_yobgvieg
POSTGRES_USER=appyobgvieg
POSTGRES_PASSWORD=please_replace_via_openssl_rand_base64_24
POSTGRES_DB=app_yobgvieg
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- RabbitMQ / Celery (AMQP) ----
# `guest:guest` is RabbitMQ's well-known default and is fine for the in-cluster
# message broker. Replace with a non-default credential if you expose the
# broker outside the docker network.
AMQP_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ---- MinIO / S3 object storage ----
# `minioadmin:minioadmin` is the upstream MinIO default; replace with strong
# credentials before exposing the storage endpoint outside docker.
USE_MINIO=1
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=please_replace_via_openssl_rand_base64_24
AWS_STORAGE_BUCKET_NAME=uploads
AWS_S3_BUCKET_NAME=uploads

# ---- Application ----
SECRET_KEY=please_replace_via_python_secrets_token_hex_32
DEBUG=1

# ---- URLs / CORS ----
WEB_URL=http://localhost:8032
APP_BASE_URL=http://localhost:8032
CORS_ALLOWED_ORIGINS=http://localhost:8032,http://localhost:3000

# ---- File uploads ----
FILE_SIZE_LIMIT=5242880
SIGNED_URL_EXPIRATION=300

# ---- API rate limiting ----
API_KEY_RATE_LIMIT=60/min

# ---- Email (null transport for dev) ----
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=noreply@localhost

# ---- Image variant (controls which app image is started) ----
#   - baseline: contains the upstream runtime (used only by test_source_code.sh)
#   - model:    a clean dev environment derived from the base image
#               (used by prepare_workspace.sh + test_model_output.sh)
IMAGE_TAG=baseline

# =============================================================================
# Evaluator configuration knobs (added by the audit pipeline)
# These are read by the evaluator harness to allow alternative implementations
# (different cookie name, header name, login endpoint, container name, etc.)
# to score correctly. Defaults match the reference implementation.
# =============================================================================
SESSION_COOKIE_NAME=session-id
API_KEY_HEADER=X-Api-Key
LOGIN_ENDPOINT=/auth/sign-in/
CSRF_ENDPOINT=/auth/get-csrf-token/
API_PREFIX=/api/
API_V1_PREFIX=/api/v1/
APP_CONTAINER_NAME=app_yobgvieg
DB_CONTAINER_NAME=db_yobgvieg
MINIO_BUCKET=uploads

# ---- LLM judge (required for full evaluation) ----
# Provide your own LLM API credentials before running ./test_source_code.sh
# or ./test_model_output.sh with LLM judge enabled.
LLM_API_KEY=please_replace_with_your_llm_api_key
LLM_API_BASE=https://api.commonstack.ai/v1
LLM_MODEL=claude-sonnet-4-5-20250929
