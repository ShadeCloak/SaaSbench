# Database
DATABASE_URL=postgresql://appyobgvieg:app123yobgvieg@db:5432/app_yobgvieg
POSTGRES_USER=appyobgvieg
POSTGRES_PASSWORD=app123yobgvieg
POSTGRES_DB=app_yobgvieg
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# RabbitMQ / Celery
AMQP_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/1

# MinIO / S3
USE_MINIO=1
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=uploads
AWS_S3_BUCKET_NAME=uploads

# Application
SECRET_KEY=sk-yobgvieg-f8a3b2c1d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9
DEBUG=1

# URLs
WEB_URL=http://localhost:8032
APP_BASE_URL=http://localhost:8032
CORS_ALLOWED_ORIGINS=http://localhost:8032,http://localhost:3000

# File uploads
FILE_SIZE_LIMIT=5242880
SIGNED_URL_EXPIRATION=300

# API rate limiting
API_KEY_RATE_LIMIT=60/min

# Email (null transport for dev)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=noreply@localhost

# IMAGE_TAG controls which app image variant to use (added by v3 rework):
#   - baseline: includes the original project runtime (only used by test_source_code.sh)
#   - model:    clean dev environment derived from base (used by prepare_workspace.sh + test_model_output.sh)
