# --------------------------------------------------------------------
# task_ididetxj — Collaborative Wiki / Knowledge base
#
# Usage:
#   cp .env.example .env
#   sed -i "s|please_replace_via_openssl_rand_hex_32|$(openssl rand -hex 32)|g" .env
#
# docker-compose.yml uses ${SECRET_KEY:?} / ${UTILS_SECRET:?} for fail-fast checks;
# missing or placeholder values will cause `docker compose up` to refuse to start.
# --------------------------------------------------------------------

# === Bind & runtime ============================================
NODE_ENV=development
PORT=8031
URL=http://localhost:8031
SERVICES=web,worker,websockets,collaboration,cron,admin
WEB_CONCURRENCY=1
LOG_LEVEL=info
DEBUG=

# === Secrets (REPLACE WITH `openssl rand -hex 32`) ===
# 64-char hex strings; the application's @IsHexadecimal + @Length(64,64) validators reject other values.
SECRET_KEY=please_replace_via_openssl_rand_hex_32
UTILS_SECRET=please_replace_via_openssl_rand_hex_32

# === PostgreSQL =================================================
DATABASE_URL=postgres://appididetxj:app123ididetxj@db:5432/app_ididetxj
PGSSLMODE=disable

# === Redis ======================================================
REDIS_URL=redis://redis:6379
# Optional: separate Redis for HocusPocus awareness (multi-process collaboration)
# REDIS_COLLABORATION_URL=redis://redis:6379

# === File storage (local by default) ============================
FILE_STORAGE=local
FILE_STORAGE_LOCAL_ROOT_DIR=/var/lib/app/data
FILE_STORAGE_UPLOAD_MAX_SIZE=262144000
FILE_STORAGE_IMPORT_MAX_SIZE=524288000

# === SMTP (null transport — magic-link tokens are logged to stdout) ==
SMTP_HOST=
SMTP_PORT=
SMTP_FROM_NAME="Knowledge Base"
SMTP_REPLY_EMAIL=
SMTP_USERNAME=
SMTP_PASSWORD=

# === Defaults ====================================================
DEFAULT_LANGUAGE=en_US
TZ=UTC

# === Application metadata ========================================
APP_NAME="Knowledge Base"

# === Session / security ==========================================
SECURE_COOKIE=false
FORCE_HTTPS=false

# === Rate limiting (defaults; tune as needed) ====================
RATE_LIMITER_REDIS_DB_NAME=

# === OAuth providers (leave empty to disable; magic-link will still work) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_RESOURCE_APP_ID=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUTH_URI=
OIDC_TOKEN_URI=
OIDC_USERINFO_URI=

# === Telemetry (off by default) ==================================
TELEMETRY=false
DD_API_KEY=
DD_SERVICE=knowledge-base
SENTRY_DSN=
