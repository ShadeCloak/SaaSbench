# IMAGE_TAG controls which app image variant to use:
#   - baseline: runtime image used by test_source_code.sh
#   - model:    clean dev environment derived from the base image
#               (used by prepare_workspace.sh + test_model_output.sh)
IMAGE_TAG=baseline

