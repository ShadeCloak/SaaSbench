# PostgreSQL
PG_DATABASE_URL=postgres://appfpumriig:app123fpumriig@db:5432/app_fpumriig
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=app_fpumriig
POSTGRES_USER=appfpumriig
POSTGRES_PASSWORD=app123fpumriig

# Redis
REDIS_URL=redis://redis:6379

# ClickHouse
CLICKHOUSE_URL=http://appfpumriig:app123fpumriig@clickhouse:8123/app_fpumriig
CLICKHOUSE_DB=app_fpumriig
CLICKHOUSE_USER=appfpumriig
CLICKHOUSE_PASSWORD=app123fpumriig

# Application
PORT=8034
NODE_PORT=8034
SERVER_URL=http://localhost:8034
FRONTEND_URL=http://localhost:8034
APP_SECRET=fpumriig_secret_key_change_in_production_abc123xyz

# Storage
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=.local-storage

# Auth
IS_MULTIWORKSPACE_ENABLED=false

# Billing (disabled by default)
IS_BILLING_ENABLED=false

# Node environment
NODE_ENV=development

# IMAGE_TAG controls which app image variant to use:
#   - baseline: contains the pre-installed runtime (used only by the source-test environment)
#   - model:    clean development environment derived from the base image
#               (used by prepare_workspace.sh + test_model_output.sh)
IMAGE_TAG=baseline
