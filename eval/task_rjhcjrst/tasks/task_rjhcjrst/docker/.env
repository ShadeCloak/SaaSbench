# =============================================================================
# task_rjhcjrst (PFM / Firefly III) — example environment file
# =============================================================================
# Copy this file to `.env` and fill in the secrets before `docker compose up`.
# All values here MUST match task.md §9 hard constraints (database name,
# port mappings, etc.) — agents that change them will fail validation.
#
# The two REQUIRED secrets below have safe placeholders in docker-compose.yml
# (`base64:00000...` / `pfm_cron_token_please_change_3xx`), so the stack starts
# even without a .env file. For real evaluations you should regenerate them:
#
#   APP_KEY            : openssl rand -base64 32 | sed 's,^,base64:,'
#   STATIC_CRON_TOKEN  : openssl rand -hex 16          # → exactly 32 chars
# =============================================================================

# ---- Laravel application key (32-char raw or base64:<44 chars>) ----
# Generate with: openssl rand -base64 32 | sed 's/^/base64:/'
APP_KEY=base64:5F4a5BE901m2oeKGqsRBsR59V4iECiexdG708mXgkX4=

# ---- Cron token (exactly 32 chars) ----
# Generate with: openssl rand -hex 16
STATIC_CRON_TOKEN=1ef6d1299cef8c3125e3e324aa7afa3a

# ---- Reference values (do not edit unless you know what you're doing) ----
# DB_CONNECTION=mysql
# DB_HOST=db
# DB_PORT=3306
# DB_DATABASE=app_rjhcjrst
# DB_USERNAME=apprjhcjrst
# DB_PASSWORD=app123rjhcjrst
# APP_URL=http://localhost:8022
# CACHE_DRIVER=file
# SESSION_DRIVER=file
# QUEUE_DRIVER=sync
# MAIL_MAILER=log

# IMAGE_TAG controls which app image variant to use (added in the v3 rework):
#   - baseline: includes the original project's runtime (used only by test_source_code.sh)
#   - model:    a clean dev environment derived from base (used by prepare_workspace.sh + test_model_output.sh)
IMAGE_TAG=baseline
