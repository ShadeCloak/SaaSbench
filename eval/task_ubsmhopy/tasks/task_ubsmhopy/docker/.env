## Database
DATABASE_URL=postgresql://appubsmhopy:app123ubsmhopy@db:5432/app_ubsmhopy
DB_HOST=db
DB_PORT=5432
DB_NAME=app_ubsmhopy
DB_USER=appubsmhopy
DB_PASSWORD=app123ubsmhopy

## Application
DOMAIN=http://localhost:8035
ROCKET_ADDRESS=0.0.0.0
ROCKET_PORT=8035

## Admin Panel
ADMIN_TOKEN=admin_token_ubsmhopy

## Registration
SIGNUPS_ALLOWED=true
INVITATIONS_ALLOWED=true
SIGNUPS_VERIFY=false

## Features
EMERGENCY_ACCESS_ALLOWED=true
ORG_EVENTS_ENABLED=true
ORG_GROUPS_ENABLED=true
SENDS_ALLOWED=true
ENABLE_WEBSOCKET=true
WEB_VAULT_ENABLED=false
PUSH_ENABLED=false

## Rate Limiting (relaxed for eval)
LOGIN_RATELIMIT_MAX_BURST=100
LOGIN_RATELIMIT_SECONDS=10
ADMIN_RATELIMIT_MAX_BURST=100
ADMIN_RATELIMIT_SECONDS=10

## Storage
DATA_FOLDER=/app/data
RSA_KEY_FILENAME=/app/data/rsa_key

## Misc
TRASH_AUTO_DELETE_DAYS=30
PASSWORD_ITERATIONS=600000
I_REALLY_WANT_VOLATILE_STORAGE=true
LOG_LEVEL=info

# IMAGE_TAG controls which app image variant to use (added by the v3 rework):
#   - baseline: includes the original project runtime (used only by test_source_code.sh)
#   - model:    base-derived clean dev environment (used by prepare_workspace.sh + test_model_output.sh)
IMAGE_TAG=baseline

## LLM judge (SaaSBench evaluation key — kept, not desensitized)
LLM_API_BASE=https://api.commonstack.ai/v1
LLM_API_KEY=please_replace_with_your_llm_api_key
LLM_MODEL=claude-sonnet-4-5-20250929
