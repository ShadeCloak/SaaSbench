# =============================================================================
# .env.example — copy to .env (`cp .env.example .env`) before `docker compose up -d`.
#
# The DB credentials and ADMIN_TOKEN below are throwaway EVALUATION FIXTURES.
# They are intentionally kept as working defaults because they are coupled to
# files that must stay byte-for-byte reproducible:
#   - docker-compose.yml hardcodes POSTGRES_USER/PASSWORD/DB (and init-db.sql)
#   - check/task_ubsmhopy/test_source_code.sh posts ADMIN_TOKEN=admin_token_ubsmhopy
# Changing them here would break the reference baseline run. For a real
# deployment, regenerate ADMIN_TOKEN (`openssl rand -base64 48`) and the DB
# password, and update docker-compose.yml/init-db.sql to match.
# =============================================================================

## Database (eval fixture — must match docker-compose.yml + init-db.sql)
DATABASE_URL=postgresql://appubsmhopy:app123ubsmhopy@db:5432/app_ubsmhopy
DB_HOST=db
DB_PORT=5432
DB_NAME=app_ubsmhopy
DB_USER=appubsmhopy
DB_PASSWORD=app123ubsmhopy

## Application
DOMAIN=http://localhost:8035
ROCKET_ADDRESS=0.0.0.0
ROCKET_PORT=8035

## Admin Panel (eval fixture — consumed by test_source_code.sh; replace via `openssl rand -base64 48` for real use)
ADMIN_TOKEN=admin_token_ubsmhopy

## Registration
SIGNUPS_ALLOWED=true
INVITATIONS_ALLOWED=true
SIGNUPS_VERIFY=false

## Features
EMERGENCY_ACCESS_ALLOWED=true
ORG_EVENTS_ENABLED=true
ORG_GROUPS_ENABLED=true
SENDS_ALLOWED=true
ENABLE_WEBSOCKET=true
WEB_VAULT_ENABLED=false
PUSH_ENABLED=false

## Rate Limiting (relaxed for eval)
LOGIN_RATELIMIT_MAX_BURST=100
LOGIN_RATELIMIT_SECONDS=10
ADMIN_RATELIMIT_MAX_BURST=100
ADMIN_RATELIMIT_SECONDS=10

## Storage
DATA_FOLDER=/app/data
RSA_KEY_FILENAME=/app/data/rsa_key

## Misc
TRASH_AUTO_DELETE_DAYS=30
PASSWORD_ITERATIONS=600000
I_REALLY_WANT_VOLATILE_STORAGE=true
LOG_LEVEL=info

# IMAGE_TAG controls which app image variant to use:
#   - baseline: contains the reference runtime (used only by test_source_code.sh)
#   - model:    clean dev environment derived from base (used by prepare_workspace.sh + test_model_output.sh)
IMAGE_TAG=baseline

## LLM judge (SaaSBench evaluation endpoint — required for the LLM-judge nodes).
## Override LLM_API_KEY via a real environment variable if you have your own.
LLM_API_BASE=https://api.commonstack.ai/v1
LLM_API_KEY=please_replace_with_your_llm_api_key
LLM_MODEL=claude-sonnet-4-5-20250929
