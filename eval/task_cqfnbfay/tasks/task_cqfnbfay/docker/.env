# IMAGE_TAG controls which app image variant docker-compose pulls:
#   - baseline: image with the upstream runtime baked in;
#               used ONLY by test_source_code.sh (the source-test harness).
#   - model:    image derived from saasbench-dev:base with no upstream code;
#               used by prepare_workspace.sh + test_model_output.sh
#               (the candidate-model evaluation harness).
IMAGE_TAG=baseline
