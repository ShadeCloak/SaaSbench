# Reviewer setup:
#   1. cp .env.example .env
#   2. Replace every `please_replace_*` placeholder with a real secret
#      (suggested generators are listed inline below).
#   3. docker compose up -d

# ---- MongoDB ----
# Application database connection (replica-set mode is recommended for
# transactional workloads).
MONGO_USER=appygamciur
# Suggested generator: openssl rand -base64 24
MONGO_PASSWORD=please_replace_via_openssl_rand_base64_24
MONGO_DB=app_ygamciur
MONGO_REPLICA_SET=rs0
PLATFORM_DB_URL=mongodb://appygamciur:please_replace_via_openssl_rand_base64_24@localhost:27017/app_ygamciur?authSource=admin

# ---- Redis (cache / session / pub-sub) ----
PLATFORM_REDIS_URL=redis://localhost:6379

# ---- Application secrets (project-internal encryption) ----
# Suggested generators:
#   PLATFORM_ENCRYPTION_PASSWORD: openssl rand -base64 32
#   PLATFORM_ENCRYPTION_SALT:     openssl rand -hex 16
PLATFORM_ENCRYPTION_PASSWORD=please_replace_via_openssl_rand_base64_32
PLATFORM_ENCRYPTION_SALT=please_replace_via_openssl_rand_hex_16

# ---- Application runtime ----
PLATFORM_MAIL_ENABLED=false
APP_GIT_ROOT=/app/git-storage
APP_PORT=8007
APP_CONTAINER_NAME=lowcode-platform

# ---- Evaluator ENV passthrough ----
# Used by check/task_ygamciur_e/evaluate/config.py and primitives.py for
# multi-implementation fairness. Override these only if your implementation
# uses a different API prefix.
API_V1_PREFIX=/api/v1

# ---- IMAGE_TAG: which app image variant to use ----
#   - baseline: contains the reference implementation runtime (used only by
#               test_source_code.sh)
#   - model:    a clean dev image derived from saasbench-dev:base (used by
#               prepare_workspace.sh + test_model_output.sh)
IMAGE_TAG=baseline

# ---- LLM judge (required by the evaluator's LLM-judge nodes) ----
# Provide a key for any OpenAI-compatible endpoint. Leaving these empty makes
# every LLM-judge node SKIPPED_LLM (deterministic nodes still run).
LLM_API_KEY=
LLM_API_BASE=https://api.commonstack.ai/v1
LLM_MODEL=claude-sonnet-4-5-20250929
