# Secret template required by docker-compose for the scheduling/booking task.
#
# Usage:
#   1. cp .env.example .env
#   2. Replace the four secret placeholders below with real random strings:
#        NEXTAUTH_SECRET     <- openssl rand -base64 32
#        APP_ENCRYPTION_KEY  <- openssl rand -base64 24   (AES-256-CBC; the base64 string decodes to exactly 32 bytes)
#        CRON_API_KEY        <- openssl rand -hex 16
#        JWT_SECRET          <- openssl rand -base64 32   (MUST be different from NEXTAUTH_SECRET)
#   3. cd docker && docker compose up -d
#
# docker-compose.yml uses ${VAR:?} fail-fast: any missing required secret
# will cause `docker compose up` to fail loudly rather than silently
# generating a weak default. The helper scripts (prepare_workspace.sh /
# test_*_code.sh) automatically generate a .env from this template if one
# is not present, but writing the secrets by hand is recommended for
# long-lived environments and cross-test consistency.

# ----- Required secrets (fail-fast on docker compose up) -----
NEXTAUTH_SECRET=please_replace_via_openssl_rand_base64_32
APP_ENCRYPTION_KEY=please_replace_via_openssl_rand_base64_24
CRON_API_KEY=please_replace_via_openssl_rand_hex_16
# JWT_SECRET MUST differ from NEXTAUTH_SECRET (do NOT reuse the same value).
JWT_SECRET=please_replace_via_openssl_rand_base64_32_must_differ_from_NEXTAUTH_SECRET

# ----- Image variant -----
# IMAGE_TAG controls which app image variant docker-compose pulls.
#   - baseline: contains the reference runtime (used by test_source_code.sh)
#   - model:    a clean derived dev environment (used by prepare_workspace.sh +
#               test_model_output.sh; the model under test installs into /app)
IMAGE_TAG=baseline

# ----- LLM judge transit credentials (provided so reviewers can reproduce LLM-judge nodes out-of-the-box) -----
# These default values point at the bench's transit endpoint. Override
# LLM_API_BASE / LLM_MODEL / LLM_API_KEY in your shell or this file to
# route LLM-judge nodes through a different provider.
LLM_API_BASE=https://api.commonstack.ai/v1
LLM_API_KEY=please_replace_with_your_llm_api_key
LLM_MODEL=claude-sonnet-4-5-20250929

# ----- Optional ENV overrides for the evaluator (reasonable defaults match the harness) -----
# API version header name + value (the evaluator probes any value sent in this
# header; setting this here lets implementations advertise an alternative).
# API_VERSION_HEADER_NAME=Api-Version
# API_VERSION_HEADER_VALUE=2024-08-13
# REST API path prefixes (the evaluator queries these on host port 8016).
# API_V1_PREFIX=/api/v1
# API_V2_PREFIX=/api/v2
# TRPC_PREFIX=/api/trpc
# Evaluator scoring knobs.
# EVAL_WEIGHTED_FLOOR=0.0
# LLM_JUDGE_PASS_THRESHOLD=0.5
# PARTIAL_MIN_RATIO=0.5
