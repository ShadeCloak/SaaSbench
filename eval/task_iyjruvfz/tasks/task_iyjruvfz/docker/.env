# task_iyjruvfz (Cal.com) — secret template required by docker compose
#
# Usage:
#   1. cp .env.example .env
#   2. Replace the placeholders below with real random strings:
#        NEXTAUTH_SECRET     ← openssl rand -base64 32
#        APP_ENCRYPTION_KEY  ← openssl rand -base64 24   (AES-256-CBC; exactly 32 bytes after base64 decoding)
#        CRON_API_KEY        ← openssl rand -hex 16
#        JWT_SECRET          ← openssl rand -base64 32
#   3. cd docker && docker compose up -d
#
# docker-compose.yml uses ${VAR:?} for fail-fast; a missing one errors out immediately instead of silently generating a weak secret.
# prepare_workspace.sh / test_*_code.sh will auto-generate one when no .env is found,
# but a manually written secret is better for long-term reuse and cross-test consistency.

NEXTAUTH_SECRET=SNSnI4l1TwA04P8N/e3/0nYHoFjWpKvIBe/CataX9v0=
APP_ENCRYPTION_KEY=RuJW+LAJP7CvD+GrgcuLfAx7wECwe27A
CRON_API_KEY=766062742195aee113c3f382f94b1fc9
JWT_SECRET=SNSnI4l1TwA04P8N/e3/0nYHoFjWpKvIBe/CataX9v0=

# IMAGE_TAG controls which app image variant to use (added by v3 change):
#   - baseline: includes the original project runtime (used only by test_source_code.sh)
#   - model:    clean dev environment derived from base (used by prepare_workspace.sh + test_model_output.sh)
IMAGE_TAG=baseline
