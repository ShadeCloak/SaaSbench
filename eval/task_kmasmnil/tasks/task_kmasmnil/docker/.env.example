# ============================================================================
# .env.example — Experience Management (XM) Platform
# ----------------------------------------------------------------------------
# Copy this file to `.env` and replace every <PLACEHOLDER> below with a real
# value before running `docker compose up -d`. The values marked as "fixture"
# are part of the evaluation contract — DO NOT change them.
#
# Quick-start (generate secure secrets):
#   openssl rand -base64 24    # → POSTGRES_PASSWORD
#   openssl rand -base64 32    # → NEXTAUTH_SECRET
#   openssl rand -hex    32    # → ENCRYPTION_KEY
#   openssl rand -hex    24    # → CRON_SECRET
# ============================================================================

# ---- Database (fixture: user/db/url shape are part of the evaluation contract) ----
POSTGRES_USER=appkmasmnil
POSTGRES_PASSWORD=please_replace_via_openssl_rand_base64_24
POSTGRES_DB=app_kmasmnil
DATABASE_URL=postgresql://appkmasmnil:please_replace_via_openssl_rand_base64_24@db:5432/app_kmasmnil

# ---- Cache (no secret) ----
REDIS_URL=redis://redis:6379

# ---- Application (fixture port + URL) ----
WEBAPP_URL=http://localhost:8024
NEXTAUTH_URL=http://localhost:8024
PORT=8024
NODE_ENV=production

# ---- Application secrets (MUST replace with random values) ----
NEXTAUTH_SECRET=please_replace_via_openssl_rand_base64_32
ENCRYPTION_KEY=please_replace_via_openssl_rand_hex_32
CRON_SECRET=please_replace_via_openssl_rand_hex_24

# ---- Feature flags (fixture: evaluation requires these to be disabled) ----
EMAIL_VERIFICATION_DISABLED=1
RATE_LIMITING_DISABLED=1
IS_XM_CLOUD=0
NEXT_TELEMETRY_DISABLED=1

# ---- SMTP placeholder (evaluation does not actually send emails) ----
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=test
SMTP_PASSWORD=test
SMTP_SECURE_ENABLED=0
MAIL_FROM=noreply@test.com

# ---- Docker image selector ----
# IMAGE_TAG=baseline runs the upstream-reference image (test_source_code.sh path).
# IMAGE_TAG=model    runs the clean development image (prepare_workspace.sh path).
IMAGE_TAG=baseline

# ---- Container names (override only if you need to run multiple instances) ----
APP_CONTAINER=xm_app
DB_CONTAINER=xm_db
REDIS_CONTAINER=xm_redis

# ---- Evaluator API path prefixes (override only for ENV-driven path layouts) ----
API_V1_PREFIX=/api/v1
API_V2_PREFIX=/api/v2
API_V3_PREFIX=/api/v3

# ---- Evaluator API-key lookup field (override only for non-default hash schemes) ----
API_KEY_HASH_FIELD=hashedKey
API_KEY_TABLE=ApiKey

# ---- LLM judge (SaaSBench-provided gateway; keep defaults unless you have your own) ----
LLM_API_KEY=please_replace_with_your_llm_api_key
LLM_API_BASE=https://api.commonstack.ai/v1
LLM_MODEL=claude-sonnet-4-5-20250929
