# Environment overrides for `docker compose`. Copy to .env.local for personal
# tweaks; the values below are the canonical task_sgdoserd defaults.

# ---- Application ----
APP_PORT=8036
METRICS_PORT=8067

# ---- Database ----
DB_PORT=5450
DB_NAME=app_sgdoserd
DB_USER=appsgdoserd
DB_PASSWORD=app123sgdoserd

# ---- Redis ----
REDIS_PORT=6392

# ---- Misc ----
TZ=UTC

# IMAGE_TAG controls which app image variant to use:
#   - baseline: contains the reference application runtime
#               (used only by test_source_code.sh)
#   - model:    base-derived clean development environment
#               (used by prepare_workspace.sh and test_model_output.sh)
IMAGE_TAG=baseline
