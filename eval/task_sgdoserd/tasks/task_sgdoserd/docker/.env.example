# task_sgdoserd — environment overrides for `docker compose`.
#
# How to use:
#   1. Copy this file to `.env` (or `.env.local` for personal tweaks).
#   2. Replace each `please_replace_*` placeholder with a strong secret. The
#      recommended generators are listed inline next to each placeholder.
#   3. Provide `LLM_API_KEY` (and `LLM_API_BASE` / `LLM_MODEL` if you want to
#      override the defaults baked into the harness). The evaluation harness
#      uses these to drive the LLM-judge nodes; without a valid key, every
#      LLM-judge node is reported as `SKIPPED_LLM` (excluded from the total).
#   4. `docker compose up -d` to bring the stack up.
#
# All values shown are the canonical task_sgdoserd defaults — they match the
# expectations encoded in the harness, so you can usually leave the structural
# values (PORT / NAME / USER) at their defaults and only touch the secrets.

# ---- Application ----
APP_PORT=8036
METRICS_PORT=8067

# ---- Database ----
DB_PORT=5450
DB_NAME=app_sgdoserd
DB_USER=appsgdoserd
# Replace via: openssl rand -base64 24
DB_PASSWORD=please_replace_via_openssl_rand_base64_24

# ---- Redis ----
REDIS_PORT=6392

# ---- Image variant ----
# Controls which application image variant `docker compose` brings up:
#   - baseline: reference application runtime — the image used by
#               test_source_code.sh to verify the harness against the
#               reference implementation.
#   - model:    base-derived clean development environment — used by
#               prepare_workspace.sh and test_model_output.sh, has no
#               application binary preinstalled so the model writes from
#               scratch.
IMAGE_TAG=baseline

# ---- Misc ----
TZ=UTC

# ---- Evaluation harness ENVs (consumed by check/task_sgdoserd_e/evaluate/) ----
# These are read by the evaluator at runtime. Defaults here are the canonical
# values the harness assumes; override only if the implementation under test
# needs a different convention.
#
# Local-mode admin Unix socket path. The harness probes this path first, then
# falls back to /tmp/admin_local.sock and a few /var/run/* candidates.
LOCAL_ADMIN_SOCKET_PATH=/tmp/mm_local.sock
#
# WebSocket auth protocol: the recommended protocol is the
# `authentication_challenge` action frame defined in the task spec; the
# harness also accepts `bearer_cookie` and `authorization_header` fallbacks.
WS_AUTH_PROTOCOL=authentication_challenge
#
# Container names used by the harness for `docker exec` calls.
APP_CONTAINER=app-sgdoserd
DB_CONTAINER=db-sgdoserd
REDIS_CONTAINER=redis-sgdoserd

# ---- LLM judge (required for the 10 LLM-judge nodes in dag.json) ----
# Provide a key valid against `LLM_API_BASE`. Without a key, those nodes are
# excluded from the total score (SKIPPED_LLM, llm_judge_skipped_maxScore is
# surfaced in the report so you can see how much potential score was dropped).
LLM_API_KEY=please_replace_with_your_llm_api_key
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
