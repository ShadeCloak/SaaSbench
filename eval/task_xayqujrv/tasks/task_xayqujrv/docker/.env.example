# task_xayqujrv — environment variable template.
# Copy this file to `.env` and replace placeholders before running `docker compose up`.
#
# Usage:
#   cp .env.example .env
#   # Optionally regenerate the Django secret key:
#   #   DJANGO_SECRET_KEY=$(openssl rand -base64 48)
#   #   sed -i "s|^DJANGO_SECRET_KEY=.*|DJANGO_SECRET_KEY=$DJANGO_SECRET_KEY|" .env
#   docker compose up -d

# ============================================================
# Required (docker-compose will fail to start without these)
# ============================================================

# Backend secret key (>= 48 random bytes recommended).
# Generate with:  openssl rand -base64 48
DJANGO_SECRET_KEY=please_replace_via_openssl_rand_base64_48

# JWT signing key for cookie-based auth.
# Leave empty to fall back to DJANGO_SECRET_KEY.
# Generate with:  openssl rand -base64 32
COOKIE_AUTH_JWT_SIGNING_KEY=

# IMAGE_TAG controls which app image variant to use:
#   - baseline: includes the reference runtime (only used by test_source_code.sh)
#   - model:    clean dev environment derived from base (used by prepare_workspace.sh + test_model_output.sh)
IMAGE_TAG=baseline

# ============================================================
# Container names (override when running multiple tasks side-by-side)
# Each container name MUST be unique across the host machine.
# ============================================================
APP_CONTAINER_NAME=task_xayqujrv-app
WORKER_CONTAINER_NAME=task_xayqujrv-worker
DB_CONTAINER_NAME=task_xayqujrv-postgres
REDIS_CONTAINER_NAME=task_xayqujrv-redis
MOCK_CONTAINER_NAME=task_xayqujrv-mock-receiver

# ============================================================
# Runtime mode (round-25 evaluator-fairness)
# Keep DEBUG=False during evaluation so 500 responses don't leak stack traces.
# Override to True only for local development.
# ============================================================
ENVIRONMENT=production
DJANGO_DEBUG=False

# ============================================================
# Evaluator fairness ENVs (consumed by evaluator dag.json / config.py)
# ============================================================

# API path prefix used by HTTP probes in dag.json. Override when the
# implementation under test uses a different versioning scheme.
API_V1_PREFIX=/api/v1

# ============================================================
# LLM judge (P17 nodes). Leave LLM_API_KEY blank to run no-LLM mode;
# the evaluator skips P17 nodes gracefully and reports the score with
# llm_judge_skipped_maxScore.
# ============================================================
LLM_API_KEY=
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ============================================================
# Optional integration secrets — populate only when enabling the corresponding feature
# ============================================================

# Chargebee billing
# CHARGEBEE_API_KEY=
# CHARGEBEE_SITE=

# GitHub App integration (Code References / Issue & PR linking)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_APP_ID=
# GITHUB_PEM=
# GITHUB_WEBHOOK_SECRET=

# Slack OAuth
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=

# Hubspot lead tracking
# HUBSPOT_ACCESS_TOKEN=

# Sentry error tracking
# SENTRY_SDK_DSN=

# AWS SES email
# AWS_SES_REGION_NAME=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Edge replication store (only when running multi-region)
# ENVIRONMENTS_TABLE_NAME_DYNAMO=
# ENVIRONMENTS_V2_TABLE_NAME_DYNAMO=
# IDENTITIES_TABLE_NAME_DYNAMO=
# ENVIRONMENTS_API_KEY_TABLE_NAME_DYNAMO=
# PROJECT_METADATA_TABLE_NAME_DYNAMO=
# EDGE_API_URL=
# EDGE_REQUEST_SIGNING_KEY=
# EDGE_RELEASE_DATETIME=2024-01-01T00:00:00Z

# SSE realtime push (only when running the SSE server alongside)
# SSE_SERVER_BASE_URL=
# SSE_AUTHENTICATION_TOKEN=
# AWS_SSE_LOGS_BUCKET_NAME=
