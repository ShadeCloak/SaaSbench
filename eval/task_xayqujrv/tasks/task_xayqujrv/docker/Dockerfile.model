# =============================================================================
# Dockerfile.model template — generic Node + Python tasks (24/30)
# =============================================================================
# Base already covers: ubuntu + Go + Node 20 (yarn4/pnpm) + Python 3.10 +
#   generic cache (React/Vue/Vite/Webpack/NX/Express/NestJS/Prisma/...).
# This template suits tasks that need no extra language runtime; it only does idle enforcement + workspace.
# =============================================================================

FROM shadetocloak/saasbench-dev:base

WORKDIR /app
ENTRYPOINT []
CMD ["sleep", "infinity"]
