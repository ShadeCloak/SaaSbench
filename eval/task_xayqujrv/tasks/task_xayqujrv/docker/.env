# Stage 3 — secrets template (commit this file; do NOT commit the real .env).
# Workflow:  cp .env.example .env   then run the openssl commands below.

# ============================================================
# Required (docker-compose will fail to start without these)
# ============================================================

# Django secret key (>= 48 random bytes recommended).
# Generate with:  openssl rand -base64 48
DJANGO_SECRET_KEY=aA4FXDnZ9npEtMg4tLAc3jxC0XeAxsZmvhAVEEHM3KHYQ499DbrAqGV+4+ziZWSM

# JWT signing key for cookie-based auth.
# Leave empty to fall back to DJANGO_SECRET_KEY.
# Generate with:  openssl rand -base64 32
COOKIE_AUTH_JWT_SIGNING_KEY=hQvRWKueiFnaKhz0A5Xyna4d932tV6bIuMl9RCCWZLs=

# ============================================================
# Optional — populate only when enabling the corresponding feature
# ============================================================

# Chargebee billing
# CHARGEBEE_API_KEY=
# CHARGEBEE_SITE=

# GitHub App integration (Code References / Issue & PR linking)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_APP_ID=
# GITHUB_PEM=
# GITHUB_WEBHOOK_SECRET=

# Slack OAuth
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=

# Hubspot lead tracking
# HUBSPOT_ACCESS_TOKEN=

# Sentry error tracking
# SENTRY_SDK_DSN=

# AWS SES email
# AWS_SES_REGION_NAME=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Edge DynamoDB tables (only when running multi-region)
# ENVIRONMENTS_TABLE_NAME_DYNAMO=
# ENVIRONMENTS_V2_TABLE_NAME_DYNAMO=
# IDENTITIES_TABLE_NAME_DYNAMO=
# ENVIRONMENTS_API_KEY_TABLE_NAME_DYNAMO=
# PROJECT_METADATA_TABLE_NAME_DYNAMO=
# EDGE_API_URL=
# EDGE_REQUEST_SIGNING_KEY=
# EDGE_RELEASE_DATETIME=2024-01-01T00:00:00Z

# SSE realtime push (only when running the SSE server alongside)
# SSE_SERVER_BASE_URL=
# SSE_AUTHENTICATION_TOKEN=
# AWS_SSE_LOGS_BUCKET_NAME=

# IMAGE_TAG controls which app image variant to use (added by the v3 rework):
#   - baseline: includes the upstream project runtime (used only by test_source_code.sh)
#   - model:    base-derived clean dev environment (used by prepare_workspace.sh + test_model_output.sh)
IMAGE_TAG=baseline
