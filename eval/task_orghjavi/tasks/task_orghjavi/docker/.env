# task_orghjavi — required runtime env vars
#
# How to use:
#   cp .env.example .env
#   # then fill in the *real* secrets (use the openssl commands below)
#
# Generated values must be regenerated PER deployment — never reuse the values
# in this file (they are placeholders only).

# ----- Phoenix runtime -----
# 64-byte secret used for Plug.Session and tokenized links.
#   openssl rand -base64 64 | tr -d '\n'
SECRET_KEY_BASE=tGFhszk73krsi6OizRj9F3D3bEN6oZ4xLwMxGTFbsCSmlXXMAwtI6Z3whoJOTXolxTskDehJ7fEQVtDi7FPhcA==

# 32-byte AES key (Base64) used by App.Auth.TOTP.Vault to encrypt totp_secret rows.
#   openssl rand -base64 32
TOTP_VAULT_KEY=/LCKTU5FTc6UwkyXK8SnrNM02hEp5bGAw5k4IIVTJxo=

# ----- Application configuration -----
BASE_URL=http://localhost:8015
DISABLE_REGISTRATION=invite_only
MAILER_ADAPTER=Bamboo.LocalAdapter
MAILER_EMAIL=app@localhost

# IMAGE_TAG selects which app image variant docker-compose pulls:
#   - baseline: bundles the pre-staged application runtime (used by
#               test_source_code.sh only).
#   - model:    a clean derived dev environment with an empty /app, used by
#               prepare_workspace.sh + test_model_output.sh.
IMAGE_TAG=baseline
