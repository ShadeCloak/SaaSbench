# =============================================================================
# task_jtbxfpny — runtime environment for the analytics platform stack.
# Keep secrets out of version control; this file is intended for local use.
# Open-source distributions ship `.env.example` instead, with placeholders.
# =============================================================================

# ----- Application identity ---------------------------------------------------
APP_PORT=8013
FLASK_APP=app
FLASK_ENV=production

# ----- Primary application database ------------------------------------------
DATABASE_DIALECT=postgresql+psycopg2
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_DB=app_jtbxfpny
DATABASE_USER=appjtbxfpny
DATABASE_PASSWORD=app123jtbxfpny
SQLALCHEMY_DATABASE_URI=postgresql+psycopg2://appjtbxfpny:app123jtbxfpny@postgres:5432/app_jtbxfpny

# Example dataset connection (re-uses the primary DB by default).
EXAMPLES_USER=appjtbxfpny
EXAMPLES_PASSWORD=app123jtbxfpny
EXAMPLES_HOST=postgres
EXAMPLES_PORT=5432
EXAMPLES_DB=app_jtbxfpny

# ----- Redis (cache / task broker / result backend) --------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
REDIS_CELERY_DB=0
REDIS_RESULTS_DB=1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ----- Application secrets (replace via `openssl rand -base64 42`) -----------
SECRET_KEY=s3cr3t_app_key_jtbxfpny_2026_change_me
GUEST_TOKEN_JWT_SECRET=s3cr3t_guest_jwt_jtbxfpny_2026
APP_SECRET_KEY=s3cr3t_app_key_jtbxfpny_2026_change_me

# ----- Application runtime paths ---------------------------------------------
APP_HOME=/app/home
PYTHONPATH=/app:/app/docker/pythonpath_dev

# ----- Operational tunables --------------------------------------------------
WEBSERVER_TIMEOUT=60
SQL_QUERY_TIMEOUT=30

# ----- Authentication --------------------------------------------------------
AUTH_TYPE=db

# ----- Image variant ---------------------------------------------------------
# IMAGE_TAG selects which app image variant is used:
#   - baseline: image with the source baseline implementation pre-loaded
#               (used by check/.../test_source_code.sh).
#   - model:    clean dev environment derived from the base image
#               (used by check/.../prepare_workspace.sh + test_model_output.sh).
IMAGE_TAG=baseline

# ----- LLM judge endpoint (evaluator's bundled relay key) --------------------
# These defaults point at the bundled relay so reviewers can run LLM-judge
# nodes out of the box. Override via env to use your own provider/model.
LLM_API_BASE=https://api.commonstack.ai/v1
LLM_API_KEY=please_replace_with_your_llm_api_key
LLM_MODEL=claude-sonnet-4-5-20250929
