# task_gmdnohlg — environment overrides for `docker compose`.
#
# How to use:
#   1. Copy this file to `.env` (or `.env.local` for personal tweaks).
#   2. Replace each `please_replace_*` placeholder with a strong secret.
#   3. Provide `LLM_API_KEY` (and `LLM_API_BASE` / `LLM_MODEL` if you want to
#      override the defaults baked into the harness). Without a valid key,
#      every LLM-judge node is reported as `SKIPPED_LLM`.
#   4. `docker compose up -d` to bring the stack up.

## ---- Database ----
DB_HOST=db
DB_PORT=5432
DB_NAME=app_gmdnohlg
DB_USER=appgmdnohlg
# Replace via: openssl rand -base64 24
DB_PASSWORD=please_replace_via_openssl_rand_base64_24
DATABASE_URL=postgresql://appgmdnohlg:please_replace_via_openssl_rand_base64_24@db:5432/app_gmdnohlg

## ---- Application ----
APP_PORT=8033
# Replace via: openssl rand -base64 32
APP_SECRET=please_replace_via_openssl_rand_base64_32
APP_ENV=production

## ---- Mail ----
MAILER_URL=null://localhost

## ---- Misc ----
TRUSTED_DOMAINS=localhost
DEFAULT_LANGUAGE=en
DEFAULT_LOCALE=en_US

## ---- Image variant ----
# Controls which application image variant `docker compose` brings up:
#   - baseline: reference application runtime (used by test_source_code.sh)
#   - model:    base-derived clean development environment (used by
#               prepare_workspace.sh and test_model_output.sh — workspace
#               is empty so the model writes from scratch)
IMAGE_TAG=baseline

## ---- Evaluation harness ENVs (consumed by check/task_gmdnohlg_e/evaluate/) ----
APP_CONTAINER=cloudcollab_app
DB_CONTAINER=cloudcollab_db
# Table prefix expected by the harness when probing the schema.
TABLE_PREFIX=cc_

## ---- LLM judge (required for the 13 LLM-judge nodes in dag.json) ----
LLM_API_KEY=please_replace_with_your_llm_api_key
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
