# task_ghmkznee — environment overrides for `docker compose`.
#
# How to use:
#   1. Copy this file to `.env` (or `.env.local` for personal tweaks).
#   2. Replace each `please_replace_*` placeholder with a strong secret. The
#      recommended generators are listed inline next to each placeholder.
#   3. Provide `LLM_API_KEY` (and `LLM_API_BASE` / `LLM_MODEL` if you want to
#      override the defaults baked into the harness). The evaluation harness
#      uses these to drive the LLM-judge nodes; without a valid key, every
#      LLM-judge node is reported as `SKIPPED_LLM` (excluded from the total).
#   4. `docker compose up -d` to bring the stack up.
#
# All values shown are the canonical task_ghmkznee defaults — they match the
# expectations encoded in the harness, so you can usually leave the structural
# values (PORT / NAME / USER) at their defaults and only touch the secrets.

# ---- Application ----
APP_PORT=8025
# Replace via: openssl rand -hex 32
APP_SECRET=please_replace_via_openssl_rand_hex_32

# ---- Image variant ----
# Controls which application image variant `docker compose` brings up:
#   - baseline: reference application runtime — the image used by
#               test_source_code.sh to verify the harness against the
#               reference implementation.
#   - model:    base-derived clean development environment — used by
#               prepare_workspace.sh and test_model_output.sh; has no
#               application binary preinstalled so the model writes from
#               scratch.
IMAGE_TAG=baseline

# ---- Database ----
DATABASE_TYPE=postgres
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=app_ghmkznee
DATABASE_USER=appghmkznee
# Replace via: openssl rand -base64 24
DATABASE_PASSWORD=please_replace_via_openssl_rand_base64_24
DATABASE_SSL_MODE=disable
DATABASE_URL=postgres://appghmkznee:please_replace_via_openssl_rand_base64_24@db:5432/app_ghmkznee?sslmode=disable
DATABASE_HOST_PORT=5448

# ---- Application admin user (created by test_source_code.sh / model code) ----
# Default credentials are intentionally weak for the evaluation fixture; change
# in any non-evaluation environment.
ADMIN_USER=admin
ADMIN_PASSWORD=admin

# ---- SMTP (optional) ----
SMTP_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_FROM_ADDRESS=admin@localhost
SMTP_FROM_NAME=App

# ---- Logging ----
LOG_LEVEL=info
LOG_MODE=console

# ---- Auth ----
ANONYMOUS_AUTH_ENABLED=false

# ---- Harness ENVs (read by evaluator at runtime) ----
# Generic API prefix and container names; defaults match docker-compose.yml.
API_PREFIX=/api
APP_CONTAINER_NAME=app_ghmkznee_app
DB_CONTAINER_NAME=app_ghmkznee_db

# LLM-judge configuration. The harness ships baked-in defaults; the most
# common reason to override is to use a local proxy or different model.
# LLM_API_KEY=please_set_to_your_evaluation_key
# LLM_API_BASE=https://api.commonstack.ai/v1
# LLM_MODEL=claude-sonnet-4-5-20250929
