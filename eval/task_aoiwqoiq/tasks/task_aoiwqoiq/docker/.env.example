# Application
RAILS_ENV=production
PORT=8020

# Database
DATABASE_URL=postgresql://appaoiwqoiq:app123aoiwqoiq@db:5432/app_aoiwqoiq
DB_HOST=db
DB_PORT=5432
DB_NAME=app_aoiwqoiq
DB_USER=appaoiwqoiq
DB_PASSWORD=app123aoiwqoiq

# App-specific database config
APP_DB_HOST=db
APP_DB_PORT=5432
APP_DB_NAME=app_aoiwqoiq
APP_DB_USERNAME=appaoiwqoiq
APP_DB_PASSWORD=app123aoiwqoiq

# Redis
REDIS_URL=redis://redis:6379
APP_REDIS_HOST=redis
APP_REDIS_PORT=6379
APP_MESSAGE_BUS_REDIS_HOST=redis

# App hostname
APP_HOSTNAME=localhost

# Security
# NOTE: replace these placeholder secrets with real values before going to production.
#       e.g. `SECRET_KEY_BASE=$(openssl rand -hex 64)`
SECRET_KEY_BASE=please_replace_via_openssl_rand_hex_64_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
APP_SECRET_KEY_BASE=please_replace_via_openssl_rand_hex_64_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Rails
RAILS_LOG_TO_STDOUT=1
RAILS_SERVE_STATIC_FILES=true
APP_SERVE_STATIC_ASSETS=true

# Mail (null transport)
SMTP_ADDRESS=localhost
SMTP_PORT=1025
SMTP_DOMAIN=localhost
APP_SMTP_ADDRESS=localhost
APP_SMTP_PORT=1025

# File storage (local)
UPLOADS_PATH=/app/public/uploads

# Developer emails (for initial admin)
APP_DEVELOPER_EMAILS=admin@example.com

# Disable SiteSetting validations for smoke test
APP_SKIP_DB_VALIDATION=1

# Performance tuning
RUBY_GC_HEAP_INIT_SLOTS=1000000
RUBY_GC_HEAP_FREE_SLOTS=500000
RUBY_GC_HEAP_GROWTH_FACTOR=1.1

# IMAGE_TAG controls which app image variant the compose file pulls:
#   - baseline: bundled runtime (used only by test_source_code.sh on the maintainer side)
#   - model:    clean derived dev environment (used by prepare_workspace.sh / test_model_output.sh)
IMAGE_TAG=baseline
