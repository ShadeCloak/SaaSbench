# Database connection settings (passed through docker-compose env_file to the
# app container and used by the application at runtime). Adjust these values
# to match your local environment; the password is a placeholder and MUST be
# replaced before running in any non-throwaway environment.
DB_HOST=db
DB_PORT=5432
DB_USER=apppkvwdnhj
DB_PASSWORD=please_replace_via_openssl_rand_base64_24
DB_NAME=app_pkvwdnhj
DB_SSL_MODE=disable
APP_ADDRESS=0.0.0.0:8010

# IMAGE_TAG controls which app image variant docker-compose will use:
#   - baseline: contains the upstream baseline runtime (used by test_source_code.sh)
#   - model:    a clean base-derived development environment (used by
#               prepare_workspace.sh + test_model_output.sh; the model must
#               start the business server itself)
IMAGE_TAG=baseline

# Evaluator runtime configuration (consumed by run_all.py / harness.py /
# primitives.py). Reviewers typically leave these at the defaults; override
# only when running against a custom container topology.
APP_CONTAINER=pkvwdnhj-app-1
DB_CONTAINER=pkvwdnhj-db-1
APP_BASE_URL=http://localhost:8010

# LLM judge configuration (required for the LLM-judge evaluation path).
# Fill in your own API key; LLM_API_BASE / LLM_MODEL default to the values
# used by the SaaSBench reference run.
LLM_API_KEY=please_paste_your_llm_api_key_here
LLM_API_BASE=https://api.commonstack.ai/v1
LLM_MODEL=claude-sonnet-4-5-20250929
