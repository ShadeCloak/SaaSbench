# Application
HTTP_PORT=8026
PUBLIC_URL=http://localhost:8026
NODE_ENV=development

# XMPP
XMPP_DOMAIN=conference.local
XMPP_MUC_DOMAIN=muc.conference.local
XMPP_PORT=5222

# Auth (0 = anonymous, 1 = requires login)
ENABLE_AUTH=0
AUTH_TYPE=

# Video Bridge
JVB_PORT=10000
JVB_AUTH_USER=jvb
# Set the two AUTH_PASSWORD values below to any random secret for self-hosting;
# they only need to match between the bridge / focus services and the XMPP server.
JVB_AUTH_PASSWORD=2204ae7fad330d31b54c9700d3b1220a

# Conference Focus
FOCUS_AUTH_PASSWORD=d9fde3a98ada671c2bca8415ba5e18db

# Optional services
ENABLE_RECORDING=0
ENABLE_TRANSCRIPTIONS=0

# Config storage path
CONFIG=~/.conference-cfg

# Timezone
TZ=UTC

# IMAGE_TAG controls which app image variant to use:
#   - baseline: bundled runtime image (used only by the source-test wrapper)
#   - model:    clean development base image (used by the model-test wrapper)
IMAGE_TAG=baseline
