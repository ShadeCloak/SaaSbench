# task_lgzivily — Docker environment variables.
#
# How to use:
#   1. Copy this file to `.env` (or `.env.local` for personal tweaks).
#   2. Replace each `please_replace_*` placeholder with a strong secret. The
#      recommended generators are listed inline next to each placeholder.
#   3. Provide `LLM_API_KEY` (and `LLM_API_BASE` / `LLM_MODEL` if you want to
#      override the defaults baked into the harness). The evaluation harness
#      uses these to drive the LLM-judge nodes; without a valid key, every
#      LLM-judge node is reported as `SKIPPED_LLM` (excluded from the total).
#   4. `docker compose up -d` to bring the stack up.
#
# All values shown are the canonical task_lgzivily defaults — they match the
# expectations encoded in the harness, so you can usually leave the structural
# values (PORT / NAME / USER) at their defaults and only touch the secrets.
#
# These values are read by:
#   - docker-compose.yml (port mappings, MariaDB init, container env passthrough)
#   - the application itself (via vlucas/phpdotenv if the agent installs it,
#     otherwise as $_SERVER vars exposed by Apache PassEnv)

# ---- Host-side ports (host:container) ----
APP_PORT=8030
DB_PORT=3310

# ---- Database (consumed by both the db service and the app) ----
DATABASE_HOST=db
DATABASE_PORT=3306
DATABASE_NAME=app_lgzivily
DATABASE_USER=applgzivily
# Replace via: openssl rand -base64 24
DATABASE_PASSWORD=please_replace_via_openssl_rand_base64_24
# Replace via: openssl rand -base64 24
DATABASE_ROOT_PASSWORD=please_replace_via_openssl_rand_base64_24
DATABASE_DSN=mysql:host=db;port=3306;dbname=app_lgzivily;charset=utf8mb4

# ---- Application runtime ----
APP_ENV=production
APP_HOST=0.0.0.0
APP_BASE_URL=http://localhost:8030
SITE_ID=default

# ---- OAuth2 / SMART on FHIR ----
OAUTH2_KEYS_DIR=/var/www/html/sites/default/documents/oauth2
OAUTH2_ACCESS_TOKEN_LIFETIME=600
OAUTH2_REFRESH_TOKEN_LIFETIME=3600
SESSION_TIMEOUT_SECONDS=7200

# ---- Misc ----
# Replace via: openssl rand -base64 32
APP_SECRET=please_replace_via_openssl_rand_base64_32
LOG_LEVEL=info
TIMEZONE=UTC

# ---- Mailer (null transport in dev; override at deploy-time) ----
MAILER_DSN=null://default
MAIL_FROM=no-reply@example.com

# ---- CORS ----
CORS_ALLOWED_ORIGINS=*

# ---- Image variant ----
# Controls which application image variant `docker compose` brings up:
#   - baseline: reference application runtime — the image used by
#               test_source_code.sh to verify the harness against the
#               reference implementation.
#   - model:    base-derived clean development environment — used by
#               prepare_workspace.sh and test_model_output.sh; has no
#               application binary preinstalled so the model writes from
#               scratch.
IMAGE_TAG=baseline

# ---- Container names used by the harness for `docker exec` ----
APP_CONTAINER=task_lgzivily_app
DB_CONTAINER=task_lgzivily_db

# ---- LLM judge (required for the LLM-judge nodes in dag.json) ----
# Provide a key valid against `LLM_API_BASE`. Without a key, those nodes are
# excluded from the total score (SKIPPED_LLM, llm_judge_skipped_maxScore is
# surfaced in the report so you can see how much potential score was dropped).
LLM_API_KEY=please_replace_with_your_llm_api_key
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
