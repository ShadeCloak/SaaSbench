# task_qmjfeopc — environment template
#
# Copy this file to `.env` and fill in the secret placeholders before
# running `docker compose up -d`. Generate strong values with, e.g.:
#   openssl rand -hex 32       # for *_KEY values
#   openssl rand -base64 24    # for passwords
#
# Reviewer note: this file is committed; the real `.env` with filled-in
# secrets MUST NOT be committed.

NODE_ENV=production
PORT=8002
BASE_URL=http://localhost:8002

# MongoDB connection — replace <REPLACE_DB_PASSWORD> with the value used in init-mongo.js.
MONGODB_URI=mongodb://appqmjfeopc:<REPLACE_DB_PASSWORD>@mongo:27017/app_qmjfeopc?authSource=admin
REDIS_URL=redis://redis:6379

# Session secrets — REPLACE with `openssl rand -hex 32` style values.
SESSION_SECRET=please_replace_via_openssl_rand_hex_32
SESSION_SECRET_KEY=please_replace_via_openssl_rand_hex_32

ADMIN_EMAIL=admin@example.com
MAILER_URL=smtp://localhost:1025

# IMAGE_TAG selects the app image variant:
#   - baseline: contains the upstream runtime (only used by test_source_code.sh)
#   - model:    base-derived clean dev environment (used by prepare_workspace.sh
#               and test_model_output.sh)
IMAGE_TAG=baseline

# -------------------------------------------------------------------------
# Evaluator-side overrides (introduced 2026-05-16; default values match the
# upstream contract so no override is needed for the reference baseline).
# -------------------------------------------------------------------------
# REST API version prefixes (defaults preserve the upstream `/api/v3` + `/api/v4`).
API_V3_PREFIX=/api/v3
API_V4_PREFIX=/api/v4

# Paired user-identifier + API-token headers (default matches the upstream
# `x-api-user` + `x-api-key`; reviewers may rename for alternative auth tests).
USER_HEADER_NAME=x-api-user
KEY_HEADER_NAME=x-api-key

# Container names referenced by the evaluator harness.
APP_CONTAINER_NAME=app_qmjfeopc
DB_CONTAINER_NAME=mongo_qmjfeopc
REDIS_CONTAINER_NAME=redis_qmjfeopc

# -------------------------------------------------------------------------
# LLM judge credentials (required when running `--with-llm`). MUST be
# provided by the reviewer; never commit real values here.
# -------------------------------------------------------------------------
LLM_API_KEY=please_replace_with_your_llm_provider_api_key
LLM_API_BASE=https://api.commonstack.ai/v1
LLM_MODEL=claude-sonnet-4-5-20250929
