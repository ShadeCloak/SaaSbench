# =============================================================================
# task_jzssnoqp — .env template
#
# Copy to .env and fill in the placeholder secrets before running
# `docker compose up -d`. Generate strong values with:
#   openssl rand -hex 64    # SECRET_KEY_BASE
#   openssl rand -hex 32    # ACTIVE_RECORD_ENCRYPTION_*
#   openssl rand -base64 24 # POSTGRES_PASSWORD
# =============================================================================

# ---- Core ----
SECRET_KEY_BASE=please_replace_via_openssl_rand_hex_64
RAILS_ENV=development
APP_ENV=development
FRONTEND_URL=http://localhost:8018

# ---- Database (interface contract — names are part of the API) ----
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DATABASE=app_jzssnoqp
POSTGRES_USERNAME=appjzssnoqp
POSTGRES_PASSWORD=please_replace_via_openssl_rand_base64_24
DATABASE_URL=postgresql://appjzssnoqp:<REPLACE_DB_PWD>@db:5432/app_jzssnoqp

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- Application ----
PORT=8018
RAILS_MAX_THREADS=5
RAILS_SERVE_STATIC_FILES=true
RAILS_LOG_TO_STDOUT=true

# ---- Background queue ----
SIDEKIQ_CONCURRENCY=10

# ---- MFA / Active Record Encryption (3 keys, generate fresh per deployment) ----
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=please_replace_via_openssl_rand_hex_32
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=please_replace_via_openssl_rand_hex_32
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=please_replace_via_openssl_rand_hex_32

# ---- Email (SMTP — null transport for dev) ----
MAILER_SENDER_EMAIL=noreply@localhost
SMTP_ADDRESS=localhost
SMTP_PORT=1025

# ---- File storage ----
ACTIVE_STORAGE_SERVICE=local

# ---- Feature flags ----
ENABLE_ACCOUNT_SIGNUP=true
DEFAULT_LOCALE=en

# ---- Rate limiting ----
CONVERSATION_MESSAGE_PER_MINUTE_LIMIT=100

# ---- Image variant selector ----
# baseline = upstream reference image (used by test_source_code.sh)
# model    = clean dev environment (used by prepare_workspace.sh +
#            test_model_output.sh)
IMAGE_TAG=baseline

# =============================================================================
# Evaluator-side env vars (read by the evaluation harness; defaults baked in)
# =============================================================================

# REST API path prefixes — defaults match the reference baseline. Override
# only if the implementation under test uses a different URL contract.
API_V1_PREFIX=/api/v1
API_V2_PREFIX=/api/v2
PLATFORM_API_PREFIX=/platform/api/v1
PUBLIC_API_PREFIX=/public/api/v1
WIDGET_API_PREFIX=/api/v1/widget

# Auth header name (the evaluator also tries common fallbacks automatically).
USER_ACCESS_TOKEN_HEADER=api_access_token

# Container name + workdir + DB/Redis container names (used by docker exec).
APP_CONTAINER=jzssnoqp-app
DB_CONTAINER=jzssnoqp-db
APP_WORKDIR=/app

# LLM judge configuration. The defaults below point at a bundled relay key
# used by the SaaSBench evaluator; leave them as-is unless you are routing the
# judge to a different provider.
LLM_API_KEY=please_replace_with_your_llm_api_key
LLM_API_BASE=https://api.commonstack.ai/v1
LLM_MODEL=claude-sonnet-4-5-20250929
# SKIP_LLM_JUDGE=0   # set to 1 to skip all LLM judge nodes (for peer-review scoring)
