# =============================================================================
# Dockerfile.model — clean development environment for model output evaluation
# =============================================================================
# This image is used by `prepare_workspace.sh` and `test_model_output.sh` to
# give the model under test an empty workspace plus a Node.js toolchain.
# It MUST NOT contain the reference application binary (otherwise the harness
# cannot tell whether the score reflects the model's own work).
#
# The base image (shadetocloak/saasbench-dev:base) bundles Ubuntu 22.04, Go,
# Node 20 with yarn4/pnpm, Python 3.10, and a shared package cache
# (React/Vue/Vite/Webpack/NX/Express/NestJS/Prisma, ...). This template suits
# tasks that need no extra language runtime — it only forces an idle PID 1 and
# mounts the workspace.
#
# PID 1 is `sleep infinity` so the harness can `docker exec` into the
# container without the application auto-starting.
# =============================================================================

FROM shadetocloak/saasbench-dev:base

WORKDIR /app
ENTRYPOINT []
CMD ["sleep", "infinity"]
