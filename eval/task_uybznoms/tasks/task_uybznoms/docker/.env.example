# =============================================================================
# task_uybznoms — .env template
#
# Copy to .env and replace the placeholder secrets before running
# `docker compose up -d`. Generate strong values with:
#   openssl rand -hex 24    # JWT_SECRET / CMS_SECRET
# The database credentials below are local-dev defaults that MUST match the
# values baked into docker-compose.yml (the db service creates this user/db).
# =============================================================================

# ---- Database (interface contract — must match docker-compose.yml) ----
DATABASE_URL=postgres://appuybznoms:app123uybznoms@db:5432/app_uybznoms

# ---- Application ----
PORT=8002
NODE_ENV=development
SERVER_URL=http://localhost:8002

# ---- Secrets (generate fresh per deployment) ----
JWT_SECRET=please_replace_via_openssl_rand_hex_24
CMS_SECRET=please_replace_via_openssl_rand_hex_24

# ---- SMTP (null transport for dev — emails logged to console) ----
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@localhost

# ---- Image variant selector ----
# baseline = upstream reference image (used by test_source_code.sh)
# model    = clean dev environment (used by prepare_workspace.sh +
#            test_model_output.sh)
IMAGE_TAG=baseline

# =============================================================================
# Evaluator-side env vars (read by the evaluation harness; defaults baked in).
# Override only if the implementation under test uses a different contract.
# =============================================================================

# App URL the harness probes (host-side mapped port from docker-compose.yml).
APP_BASE_URL=http://localhost:8006

# Database access from the host (docker-compose maps 5432 -> 5435).
DB_HOST=localhost
DB_PORT=5435
DB_NAME=app_uybznoms
DB_USER=appuybznoms
DB_PASSWORD=app123uybznoms

# Container names (used by docker exec).
APP_CONTAINER=app_uybznoms
DB_CONTAINER=db_uybznoms

# Evaluation users (the framework's first-register flow seeds the admin).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
USER_EMAIL=editor@test.com
USER_PASSWORD=Test1234!
RESTRICTED_EMAIL=restricted@test.com
RESTRICTED_PASSWORD=Test1234!

# Auth session cookie name (the harness sends the auth token under this name).
# Default matches the reference baseline contract ("{slug}-token").
AUTH_COOKIE_NAME=payload-token

# LLM judge configuration. The defaults point at the bundled SaaSBench relay
# key; leave as-is unless routing the judge to a different provider.
LLM_API_KEY=please_replace_with_your_llm_api_key
LLM_API_BASE=https://api.commonstack.ai/v1
LLM_MODEL=claude-sonnet-4-5-20250929
# SKIP_LLM_JUDGE=0   # set to 1 to skip all LLM judge nodes (peer-review scoring)
