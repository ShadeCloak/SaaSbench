# ============================================================
# Container-internal address vs host address notes:
#   Inside the container: use the service name as the hostname (e.g. mysql, elasticsearch, kafka:29092)
#   From the host: use the mapped ports (e.g. localhost:3308, localhost:9201, localhost:9093)
# The following environment variables are for use inside the container (from the app container's perspective)
# ============================================================

# MySQL Configuration (container-internal address)
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=app_ychlukjm
MYSQL_USERNAME=appychlukjm
MYSQL_PASSWORD=app123ychlukjm
MYSQL_ROOT_PASSWORD=root123

# External MySQL access (from host)
MYSQL_EXTERNAL_PORT=3308

# Elasticsearch Configuration
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_EXTERNAL_PORT=9201

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_EXTERNAL_PORT=9093

# Schema Registry Configuration
SCHEMA_REGISTRY_URL=http://schema-registry:8081

# Neo4j Configuration (optional graph database)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4j_pass_ychlukjm

# Application Configuration
APPLICATION_PORT=8019
AUTH_ENABLED=true
DEFAULT_CLI_VERSION=0.0.0.0

# JDBC Connection String (for application use)
JDBC_URL=jdbc:mysql://mysql:3306/app_ychlukjm?useSSL=false&allowPublicKeyRetrieval=true&characterEncoding=UTF-8

# Kafka Topics Configuration
MCP_TOPIC=MetadataChangeProposal_v1
FAILED_MCP_TOPIC=FailedMetadataChangeProposal_v1
MCL_VERSIONED_TOPIC=MetadataChangeLog_Versioned_v1
MCL_TIMESERIES_TOPIC=MetadataChangeLog_Timeseries_v1
MAE_TOPIC=MetadataAuditEvent_v4
PE_TOPIC=PlatformEvent_v1
USAGE_EVENT_TOPIC=UsageEvent_v1

# IMAGE_TAG controls which app image variant to use (added by v3 rework):
#   - baseline: includes the original project runtime (used only by test_source_code.sh)
#   - model:    clean dev environment derived from base (used by prepare_workspace.sh + test_model_output.sh)
IMAGE_TAG=baseline
