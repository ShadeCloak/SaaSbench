# Copy this file to .env and fill in real values before `docker compose up -d`.

APP_ENV=prod
# Generate with: openssl rand -hex 32
APP_SECRET=please_replace_via_openssl_rand_hex_32

DB_NAME=timetracker_db
DB_USER=tt_user
# Generate with: openssl rand -base64 24
DB_PASSWORD=please_replace_via_openssl_rand_base64_24
# Generate with: openssl rand -base64 24
DB_ROOT_PASSWORD=please_replace_via_openssl_rand_base64_24

MAILER_FROM=app@example.com
MAILER_URL=null://null

CORS_ALLOW_ORIGIN=^https?://localhost(:[0-9]+)?$

# IMAGE_TAG controls which app image variant to use:
#   - baseline: image containing the reference runtime (used by test_source_code.sh)
#   - model:    clean dev environment derived from base (used by prepare_workspace.sh + test_model_output.sh)
IMAGE_TAG=baseline

# --- Evaluator configuration (optional; defaults preserve reference behavior) ---
# Container names (override only if you rename the compose services).
APP_CONTAINER_NAME=timetracker-app
DB_CONTAINER_NAME=timetracker-db
# Database table prefix accepted by the evaluator (reference default; the
# evaluator also accepts tt_ and no prefix automatically).
TABLE_PREFIX=kimai2_
# API authentication header name (reference default).
API_AUTH_HEADER=X-AUTH-TOKEN

# --- LLM judge (required for the LLM-judged evaluation nodes) ---
# Fill in your own evaluation API credentials.
LLM_API_KEY=please_replace_with_your_eval_api_key
LLM_API_BASE=https://api.commonstack.ai/v1
LLM_MODEL=claude-sonnet-4-5-20250929
