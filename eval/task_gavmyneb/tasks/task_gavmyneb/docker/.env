# task_gavmyneb environment variable template
# Usage: cp .env.example .env, then change the secrets (POSTGRES_PASSWORD / SECRET_KEY_BASE)
#
# Note: ENCRYPTION_KEY is hardcoded to the Canvas default in docker-compose.yml
#     (encrypted fields like access_token in the frozen image can only be decrypted with this key)

# Rails mode
RAILS_ENV=development

# application secret (generate: openssl rand -hex 64)
SECRET_KEY_BASE=please_replace_with_openssl_rand_hex_64

# the image already uses the following hardcoded values; changing them requires re-running db setup + recreating tokens
# ENCRYPTION_KEY=facdd3a131ddd8988b14f6e4e01039c93cfa0160
# POSTGRES_PASSWORD=sekret

# IMAGE_TAG controls which app image variant to use (added by v3 rework):
#   - baseline: includes the original project runtime (only used by test_source_code.sh)
#   - model:    clean dev environment derived from base (used by prepare_workspace.sh + test_model_output.sh)
IMAGE_TAG=baseline
