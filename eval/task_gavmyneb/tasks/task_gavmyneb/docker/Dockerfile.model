# =============================================================================
# Dockerfile.model — generic Ruby development environment for the model under
# test. Provides Ruby 3.x + Bundler + system build tools so the model can
# install application dependencies (e.g., bundle install / yarn install) and
# run a web framework of its choice. The container has no application server
# pre-started — the model is responsible for starting Puma / Rails server /
# any other process via `docker exec` per prompt_for_model.md.
# =============================================================================

ARG BASE_IMAGE=shadetocloak/saasbench-dev:base
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-e", "-o", "pipefail", "-c"]

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        ruby-full ruby-dev libyaml-dev \
 && rm -rf /var/lib/apt/lists/* \
 && ruby --version

# Optional: configure a regional Ruby gem mirror for faster install in
# bandwidth-constrained networks. Pass --build-arg GEM_MIRROR=<url> to enable.
ARG GEM_MIRROR=
RUN if [ -n "$GEM_MIRROR" ]; then \
        gem sources --remove https://rubygems.org/ 2>/dev/null || true; \
        gem sources -a "$GEM_MIRROR"; \
        bundle config mirror.https://rubygems.org "$GEM_MIRROR"; \
    fi \
 && gem install bundler --no-document

WORKDIR /app
ENTRYPOINT []
CMD ["sleep", "infinity"]
