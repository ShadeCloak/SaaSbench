# task_mnmtxiwb environment variable template
# Usage: cp .env.example .env, then replace the placeholders below with real secrets
#
# Note: encryption-related keys are written into the data by the db seed process on first use;
#       generate new values with openssl first, then run db:prepare to re-seed, to keep the keys
#       consistent within a single run.

# Application secret (generate: openssl rand -hex 64)
SECRET_KEY_BASE=please_replace_with_openssl_rand_hex_64

# ActiveRecord encryption keys (generate: openssl rand -hex 16)
ENCRYPTION_PRIMARY_KEY=please_replace_with_openssl_rand_hex_16
ENCRYPTION_DETERMINISTIC_KEY=please_replace_with_openssl_rand_hex_16
ENCRYPTION_KEY_DERIVATION_SALT=please_replace_with_openssl_rand_hex_16

# IMAGE_TAG controls which image variant to use:
#   - baseline: includes the reference implementation runtime (used only by test_source_code.sh)
#   - model:    clean dev environment (used by prepare_workspace.sh + test_model_output.sh)
IMAGE_TAG=baseline
